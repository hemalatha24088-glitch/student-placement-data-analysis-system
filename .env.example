# ==============================================================================
# Student Placement Data Analysis System - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual configuration.
# Never commit .env to version control.
# ==============================================================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=placement_db
DB_SSL=false

# Flask Application Settings
SECRET_KEY=generate_a_strong_random_secret_key_here
FLASK_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=5000

# Optional Demo Mode (Set to true ONLY in sandbox/evaluation environments)
# When enabled, pre-configured demo buttons appear on the login screen.
DEMO_MODE=false

# Google OAuth 2.0 (Optional)
# If left blank or unset, Google Login button will remain hidden.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
